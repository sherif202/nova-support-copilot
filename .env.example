# Copy this file to a new file named .env (no ".example") and paste your key after the = sign.
# Never commit .env, never paste the key into a chat, never let it appear in a screenshot.
ANTHROPIC_API_KEY=

# Models (Stage 3). Use the IDs exactly as written. The bake-off decides the provider and the answer model.
PROVIDER=anthropic
UNDERSTAND_MODEL=claude-haiku-5-5
ANSWER_MODEL=claude-haiku-5-5
ANSWER_EFFORT=low
JUDGE_MODEL=claude-opus-5-5
# Backup from another vendor, set after the bake-off (build step 14b)
BACKUP_PROVIDER=
BACKUP_MODEL=

# Other vendors (Stage 3 model check). Leave empty any you don't use. Same rules as the Anthropic key.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: one key that reaches Claude, GPT and Gemini, for quick tests only (not for real customers)
OPENROUTER_API_KEY=

# Which models "npm run model-check" tests, as provider:model. Copy exact model IDs from each vendor's models page.
MODEL_CHECK_RUNS=anthropic:claude-haiku-5-5,openai:gpt-6-luna,google:gemini-2.5-flash-lite
EGP_PER_USD=50

# Testing only (build steps 8b and 14): lets a test request set the "now" time for maintenance cases. Keep false.
ALLOW_TEST_NOW=false
